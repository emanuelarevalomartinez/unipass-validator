{
  "name": "unipass-validator",
  "version": "0.1.3",
  "description": "Advanced and universal password validation for browser and Node.js environments. Includes strength scoring, blacklist check, and adaptive security rules.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/node/index.js",
  "module": "./dist/browser/index.js",
  "exports": {
    "./browser": {
      "import": "./dist/browser/index.js",
      "types": "./dist/browser/index.d.ts"
    },
    "./node": {
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.js",
      "types": "./dist/node/index.d.ts"
    }
  },
  "scripts": {
    "build:node": "tsc --project tsconfig.node.json",
    "build:browser": "tsc --project tsconfig.browser.json",
    "build": "npm run build:node && npm run build:browser",
    "pack:npm": "npm pack",
    "publish:npm": "npm publish --access public"
  },
  "dependencies": {
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/zxcvbn": "^4.4.5",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/emanuelarevalomartinez/unipass-validator.git"
  },
  "keywords": [
    "password",
    "validation",
    "strength",
    "typescript",
    "node",
    "browser",
    "security"
  ]
}
